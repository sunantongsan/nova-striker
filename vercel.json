{
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "npm test && node scripts/patch.cjs",
  "outputDirectory": "patch-dist",
  "headers": [
    {"source":"/patches/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]},
    {"source":"/objects/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"},{"key":"Content-Type","value":"application/octet-stream"},{"key":"X-Content-Type-Options","value":"nosniff"}]}
  ]
}
